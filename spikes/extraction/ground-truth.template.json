{
  "corpus": "data/archives/<corpus>/manifest.json",
  "corpusSha256": "[empreinte du manifeste donnée par npm run collect]",
  "sections": [
    {
      "id": "fiscalite",
      "label": "[intitulé de la section sur le site]",
      "parts": [{ "documentId": "[id d'une page web du corpus, voir corpus.txt]" }]
    },
    {
      "id": "retraite",
      "label": "[intitulé de la section]",
      "parts": [{ "documentId": "[id d'un PDF du corpus]", "pages": { "from": 0, "to": 0 } }]
    },
    {
      "id": "logement",
      "label": "[intitulé de la section]",
      "parts": [{ "documentId": "[id]" }, { "documentId": "[autre id]" }]
    }
  ],
  "measures": [
    {
      "id": "gt-01",
      "sectionId": "fiscalite",
      "documentId": "[id du document, voir corpus.txt]",
      "page": 1,
      "quote": "[citation exacte copiée depuis corpus.txt]",
      "description": "[ce que dit la mesure, en une phrase neutre]",
      "values": [
        { "label": "[ex. taux de la 2e tranche]", "value": 0, "unit": "pourcent" },
        { "label": "[ex. date d'application annoncée]", "value": "AAAA", "unit": "date" }
      ]
    },
    {
      "id": "gt-02",
      "sectionId": "logement",
      "documentId": "[id du document]",
      "quote": "[citation exacte d'une mesure sans chiffre]",
      "description": "[ce que dit la mesure, en une phrase neutre]",
      "values": []
    }
  ],
  "annotatedBy": "[initiales]",
  "annotatedAt": "[AAAA-MM-JJ]"
}
