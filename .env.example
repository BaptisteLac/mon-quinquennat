# Copier en .env (jamais commité) et remplir.

# Test n°1 — extraction (spikes/extraction)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modèles, au format fournisseur:modèle
EXTRACT_MODEL_A=anthropic:claude-opus-5-5
EXTRACT_MODEL_B=anthropic:claude-sonnet-5-5
